# Required application settings
APP_ENV=development
APP_PORT=3000
DATABASE_URL=postgresql://dokana_runtime_login:change-me@localhost:5432/dokana
DATABASE_SSL_MODE=disable

# Required only for approved migration or administrative commands
DATABASE_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/dokana
DATABASE_MIGRATION_URL=postgresql://dokana_migration_login:change-me@localhost:5432/dokana

# Required by the isolated authentication database pool
AUTH_DATABASE_URL=postgresql://dokana_auth_login:change-me@localhost:5432/dokana
AUTH_DB_POOL_MAX=5

# Authentication signing and lifetime settings
# Generate a unique unpadded base64url secret containing at least 32 random bytes.
AUTH_TOKEN_ISSUER=dokana-backend
AUTH_TOKEN_AUDIENCE=dokana-mobile
AUTH_ACCESS_TOKEN_ACTIVE_KID=local-v1
AUTH_ACCESS_TOKEN_ACTIVE_SECRET=change-me
AUTH_ACCESS_TOKEN_PREVIOUS_KEYS={}
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=2592000

# Logging and request tracing
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
REQUEST_ID_TRUST_INCOMING=false

# HTTP security
CORS_ORIGINS=
TRUST_PROXY=false
REQUEST_BODY_LIMIT_BYTES=1048576
API_VERSION=1

# Runtime connection pool and query safety
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=2000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# Readiness timeout
HEALTH_CHECK_TIMEOUT_MS=2000

# Integration tests are skipped unless this disposable/read-only URL is set
TEST_DATABASE_URL=
TEST_DATABASE_SSL_MODE=disable
