{
  "name": "dokana-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend infrastructure for the Dokana offline-first SaaS platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --enable-source-maps dist/main.js",
    "start:prod": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "jest --config test/jest.unit.config.cjs --runInBand",
    "test:integration": "jest --config test/jest.integration.config.cjs --runInBand",
    "test:security": "jest --config test/jest.integration.config.cjs --runInBand test/station3-security.integration-spec.ts",
    "test:cov": "jest --config test/jest.unit.config.cjs --runInBand --coverage",
    "db:provision:station3": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/provision-station3-roles.ps1",
    "auth:configure:local": "tsx scripts/configure-local-auth.ts",
    "db:migrate:bootstrap:check": "tsx scripts/bootstrap-migration-foundation.ts verify",
    "db:migrate:bootstrap": "tsx scripts/bootstrap-migration-foundation.ts",
    "db:migrate:bootstrap:auth-schema:check": "tsx scripts/bootstrap-authentication-schema.ts verify",
    "db:migrate:bootstrap:auth-schema": "tsx scripts/bootstrap-authentication-schema.ts",
    "db:migrate": "tsx scripts/migrate.ts apply",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "db:migrate:verify": "tsx scripts/migrate.ts verify",
    "db:check": "tsx scripts/check-database.ts runtime",
    "db:check:admin": "tsx scripts/check-database.ts admin",
    "db:check:auth": "tsx scripts/check-database.ts auth",
    "db:check:migration": "tsx scripts/check-database.ts migration"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.0.0",
    "jose": "^5.10.0",
    "libphonenumber-js": "1.13.10",
    "nestjs-pino": "^4.0.0",
    "pg": "^8.0.0",
    "pino": "^9.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
